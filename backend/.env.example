# StockFlow Environment Variables Template
# Copy this file to .env and configure for your environment:
# cp .env.example .env

# Database Connection (PostgreSQL or SQLite)
DATABASE_URL=sqlite:///./stockflow.db

# JWT Secret Key (Generate a secure random key for production, e.g., using `openssl rand -hex 32`)
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production
